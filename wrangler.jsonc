{
	"name": "latte-recipe",
	"compatibility_date": "2026-08-15",
	"main": "./src/api.js",
	"assets": {
		"directory": "./public",
		// Assets are matched before the Worker by default; /api/* has to opt out.
		"run_worker_first": ["/api/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "latte-shots",
			"database_id": "b7a4abdb-6e2f-4a01-b214-38e9e9c946e3"
		}
	],
	"ratelimits": [
		{
			"name": "WRITE_LIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 20, "period": 60 }
		}
	],
	"observability": { "enabled": true }
}
